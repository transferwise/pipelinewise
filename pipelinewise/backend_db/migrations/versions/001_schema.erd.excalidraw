{
  "type": "excalidraw",
  "version": 2,
  "source": "pipelinewise-erd",
  "elements": [
    {"id": "t1", "type": "rectangle", "x": 20, "y": 20, "width": 400, "height": 480, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l1", "type": "text", "x": 30, "y": 25, "width": 380, "height": 470, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_checks\n\"Versioned check definitions\nimported from YAML config\"\n───────────────────────────────\nPK  check_id              UUID\n    full_check_name       TEXT\n    revision              INTEGER\n    config_hash           CHAR(64)\n    canonical_config      JSONB\n    target_id             TEXT\n    tap_id                TEXT\n    source_type           TEXT\n    target_type           TEXT\n    source_database       TEXT\n    target_database       TEXT\n    source_schema         TEXT\n    source_table          TEXT\n    target_schema         TEXT\n    target_table          TEXT\n    source_key_column     TEXT\n    target_key_column     TEXT\n    source_timestamp_col  TEXT\n    target_timestamp_col  TEXT\n    checks                JSONB\n    frequency             TEXT\n    window_start_seconds  BIGINT  CK >0\n    window_end_seconds    BIGINT  CK ≥0\n    statement_timeout_s   BIGINT  CK >0\n    current               BOOLEAN\n    created_at            TIMESTAMPTZ\n    superseded_at         TIMESTAMPTZ\nUQ  (full_check_name, revision)\nUQ  full_check_name WHERE current"},

    {"id": "t2", "type": "rectangle", "x": 520, "y": 20, "width": 360, "height": 245, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l2", "type": "text", "x": 530, "y": 25, "width": 340, "height": 235, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_preflights\n\"Source query plan analysis\nbefore each check execution\"\n───────────────────────────────\nPK  preflight_id          UUID\nFK  check_id              UUID → dd_checks\n    status                TEXT\n    checked_at            TIMESTAMPTZ\n    query_fingerprint     CHAR(64)\n    index_metadata        JSONB\n    findings              JSONB\n    error                 TEXT\n    table_rows            BIGINT\n    row_limit             BIGINT\n    has_leading_index     BOOLEAN"},

    {"id": "t3", "type": "rectangle", "x": 520, "y": 285, "width": 390, "height": 325, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l3", "type": "text", "x": 530, "y": 290, "width": 370, "height": 315, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_runs\n\"One row per comparison attempt\nfor a scheduled time window\"\n───────────────────────────────\nPK  run_id                UUID\nFK  dd_check_id           UUID → dd_checks\n    scheduled_for         TIMESTAMPTZ\n    window_start          TIMESTAMPTZ\n    window_end            TIMESTAMPTZ\n    attempt               INTEGER\n    trigger               TEXT\n    status                TEXT\nFK  rerun_of_run_id       UUID (self)\n    remediation_reference TEXT\nFK  preflight_id          UUID → dd_preflights\n    started_at            TIMESTAMPTZ\n    finished_at           TIMESTAMPTZ\n    error                 TEXT\nCK  window_start < window_end\nUQ  (dd_check_id, scheduled_for, attempt)"},

    {"id": "t4", "type": "rectangle", "x": 1010, "y": 285, "width": 340, "height": 210, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l4", "type": "text", "x": 1020, "y": 290, "width": 320, "height": 200, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_results\n\"Per-check-type outcome detail\nfor each run\"\n───────────────────────────────\nPK  run_id                UUID → dd_runs\nPK  check_type            TEXT\n    status                TEXT\n    source_value          JSONB\n    target_value          JSONB\n    source_query_seconds  DOUBLE\n    target_query_seconds  DOUBLE\n    error                 TEXT"},

    {"id": "t6", "type": "rectangle", "x": 20, "y": 560, "width": 400, "height": 240, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l6", "type": "text", "x": 30, "y": 565, "width": 380, "height": 230, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_effective_attempts\n\"Latest terminal attempt for each\ndata-diff scheduled slot\"\n───────────────────────────────\nPK  check_id              UUID → dd_checks\nPK  scheduled_for         TIMESTAMPTZ\nFK  run_id                UUID UNIQUE → dd_runs\n    attempt               INTEGER CK >0\n    window_start          TIMESTAMPTZ\n    window_end            TIMESTAMPTZ\n    status                TEXT\nCK  window_start < window_end"},

    {"id": "t5", "type": "rectangle", "x": 520, "y": 660, "width": 390, "height": 295, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l5", "type": "text", "x": 530, "y": 665, "width": 370, "height": 285, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_coverage_events\n\"Append-only log tracking the\nverified-through watermark\"\n───────────────────────────────\nPK  coverage_event_id     UUID\n    event_sequence        BIGSERIAL UQ\nFK  check_id              UUID → dd_checks\nFK  evaluated_run_id      UUID UNIQUE → dd_runs\n    event_type            TEXT\n    coverage_start        TIMESTAMPTZ\n    prev_verified_through TIMESTAMPTZ\n    verified_through      TIMESTAMPTZ\n    max_observed_end      TIMESTAMPTZ\n    coverage_status       TEXT\nFK  blocking_run_id       UUID → dd_runs\n    recorded_at           TIMESTAMPTZ\n    reason                TEXT\nCK  coverage_start <= verified_through\nCK  verified_through <= max_observed_end"},

    {"id": "t7", "type": "rectangle", "x": 1010, "y": 700, "width": 390, "height": 300, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "roundness": {"type": 3}},
    {"id": "l7", "type": "text", "x": 1020, "y": 705, "width": 370, "height": 290, "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "dd_coverage_state\n\"Materialized current coverage\nwatermark for each check\"\n───────────────────────────────\nPK  check_id              UUID → dd_checks\n    coverage_start        TIMESTAMPTZ\n    verified_through      TIMESTAMPTZ\n    max_observed_end      TIMESTAMPTZ\n    coverage_status       TEXT\nFK  blocking_run_id       UUID → dd_runs\nFK  evaluated_run_id      UUID → dd_runs\n    event_type            TEXT\n    state_version         BIGINT CK >0\n    updated_at            TIMESTAMPTZ\n    reason                TEXT\nCK  coverage_start <= verified_through\nCK  verified_through <= max_observed_end"},

    {"id": "views", "type": "rectangle", "x": 1010, "y": 550, "width": 340, "height": 110, "strokeColor": "#868e96", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "roundness": {"type": 3}, "strokeStyle": "dashed"},
    {"id": "lbl-views", "type": "text", "x": 1020, "y": 555, "width": 320, "height": 100, "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
     "text": "Views\n───────────────────────────────\ndd_current_coverage\n  Coverage state joined to check identity\ndd_remediation_history\n  Failed runs paired with their remediation attempts"},

    {"id": "fk1", "type": "arrow", "x": 520, "y": 87, "width": 100, "height": 0, "points": [[0, 0], [-100, 0]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e"},
    {"id": "fk1-many", "type": "text", "x": 498, "y": 75, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},
    {"id": "fk1-one", "type": "text", "x": 425, "y": 75, "width": 10, "height": 15, "text": "1", "fontSize": 14, "fontFamily": 3},

    {"id": "fk2", "type": "arrow", "x": 520, "y": 337, "width": 100, "height": 265, "points": [[0, 0], [-50, 0], [-50, -265], [-100, -265]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e", "roundness": null},
    {"id": "fk2-many", "type": "text", "x": 498, "y": 325, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},
    {"id": "fk2-one", "type": "text", "x": 425, "y": 60, "width": 10, "height": 15, "text": "1", "fontSize": 14, "fontFamily": 3},

    {"id": "fk3", "type": "arrow", "x": 700, "y": 285, "width": 0, "height": 50, "points": [[0, 0], [0, -50]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e"},
    {"id": "fk3-many", "type": "text", "x": 705, "y": 275, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},
    {"id": "fk3-one", "type": "text", "x": 705, "y": 238, "width": 10, "height": 15, "text": "1", "fontSize": 14, "fontFamily": 3},

    {"id": "fk4", "type": "arrow", "x": 1010, "y": 337, "width": 100, "height": 0, "points": [[0, 0], [-100, 0]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e"},
    {"id": "fk4-many", "type": "text", "x": 988, "y": 325, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},
    {"id": "fk4-one", "type": "text", "x": 915, "y": 325, "width": 10, "height": 15, "text": "1", "fontSize": 14, "fontFamily": 3},

    {"id": "fk5", "type": "arrow", "x": 520, "y": 715, "width": 100, "height": 643, "points": [[0, 0], [-40, 0], [-40, -643], [-100, -643]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e", "roundness": null},
    {"id": "fk5-many", "type": "text", "x": 498, "y": 703, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},

    {"id": "fk6", "type": "arrow", "x": 680, "y": 660, "width": 0, "height": 50, "points": [[0, 0], [0, -50]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e"},
    {"id": "fk6-label", "type": "text", "x": 685, "y": 650, "width": 15, "height": 15, "text": "1:1", "fontSize": 12, "fontFamily": 3},

    {"id": "fk-self", "type": "arrow", "x": 910, "y": 420, "width": 40, "height": 60, "points": [[0, 0], [40, 0], [40, -60], [0, -60]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#868e96"},
    {"id": "fk-self-label", "type": "text", "x": 955, "y": 375, "width": 30, "height": 15, "text": "0..1", "fontSize": 11, "fontFamily": 3, "strokeColor": "#868e96"},

    {"id": "fk-effective-check", "type": "arrow", "x": 220, "y": 560, "width": 0, "height": 60, "points": [[0, 0], [0, -60]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e"},
    {"id": "fk-effective-check-many", "type": "text", "x": 225, "y": 545, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},
    {"id": "fk-effective-check-one", "type": "text", "x": 225, "y": 505, "width": 10, "height": 15, "text": "1", "fontSize": 14, "fontFamily": 3},

    {"id": "fk-effective-run", "type": "arrow", "x": 420, "y": 640, "width": 100, "height": 230, "points": [[0, 0], [50, 0], [50, -230], [100, -230]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e", "roundness": null},
    {"id": "fk-effective-run-one", "type": "text", "x": 425, "y": 625, "width": 25, "height": 15, "text": "1:1", "fontSize": 12, "fontFamily": 3},

    {"id": "fk-state-run", "type": "arrow", "x": 1205, "y": 700, "width": 295, "height": 250, "points": [[0, 0], [0, -40], [-245, -40], [-245, -250], [-295, -250]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e", "roundness": null},
    {"id": "fk-state-run-many", "type": "text", "x": 1185, "y": 680, "width": 10, "height": 15, "text": "*", "fontSize": 14, "fontFamily": 3},

    {"id": "fk-state-check", "type": "arrow", "x": 1400, "y": 760, "width": 1030, "height": 690, "points": [[0, 0], [50, 0], [50, -690], [-980, -690]], "startArrowhead": null, "endArrowhead": "triangle", "strokeColor": "#1e1e1e", "roundness": null},
    {"id": "fk-state-check-zero-one", "type": "text", "x": 1405, "y": 740, "width": 30, "height": 15, "text": "0..1", "fontSize": 11, "fontFamily": 3},
    {"id": "fk-state-check-one", "type": "text", "x": 425, "y": 55, "width": 10, "height": 15, "text": "1", "fontSize": 14, "fontFamily": 3}
  ],
  "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 10}
}
