# ------------------------------------------------------------------------------
# Test YugabyteDB database credentials used as test source database.
#
# Copy to `tests/integration/env` before running `make integration_test`; that
# path stays git-ignored so local edits cannot leak credentials.
#
# Defaults match the `make start_db` compose stack: yugabyted ships a single
# `yugabyte` superuser and database, and ignores POSTGRES_* image variables.
# ------------------------------------------------------------------------------
export TAP_YUGABYTE_HOST=localhost
export TAP_YUGABYTE_PORT=5433
export TAP_YUGABYTE_USER=yugabyte
export TAP_YUGABYTE_PASSWORD=yugabyte
export TAP_YUGABYTE_DB=yugabyte
