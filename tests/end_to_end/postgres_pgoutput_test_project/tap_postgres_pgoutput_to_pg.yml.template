---

id: "postgres_pgoutput_migration"
name: "PostgreSQL pgoutput migration source"
type: "tap-postgres"
owner: "test-runner"

db_conn:
  host: "${TAP_POSTGRES_HOST}"
  port: ${TAP_POSTGRES_PORT}
  user: "${TAP_POSTGRES_USER}"
  password: "${TAP_POSTGRES_PASSWORD}"
  dbname: "${TAP_POSTGRES_DB}"
  logical_poll_total_seconds: 10
  publication_fence_timeout_seconds: 20
  break_at_end_lsn: true
  max_run_seconds: 20
  fastsync_parallelism: 1

target: "postgres_pgoutput_migration_dwh"
batch_size_rows: 1000
stream_buffer_size: 0

schemas:
  - source_schema: "ppw_e2e_pgoutput_source"
    target_schema: "ppw_e2e_pgoutput_target"
    tables:
      - table_name: "migration_records"
        replication_method: "LOG_BASED"
