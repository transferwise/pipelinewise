---

id: "mysql_to_sf_native"
name: "MySQL native multiline FastSync source"
type: "tap-mysql"
owner: "test-runner"

db_conn:
  host: "${TAP_ORACLE_MYSQL_HOST}"
  port: ${TAP_ORACLE_MYSQL_PORT}
  user: "${TAP_ORACLE_MYSQL_USER}"
  password: "${TAP_ORACLE_MYSQL_PASSWORD}"
  dbname: "${TAP_ORACLE_MYSQL_DB}"
  engine: mysql
  use_gtid: false

target: "snowflake"
batch_size_rows: 1000
stream_buffer_size: 0

schemas:
  - source_schema: "${TAP_ORACLE_MYSQL_DB}"
    target_schema: "ppw_e2e_tap_oracle_mysql_2${TARGET_SNOWFLAKE_SCHEMA_POSTFIX}"
    tables:
      - table_name: "multiline_values"
        replication_method: "INCREMENTAL"
        replication_key: "id"
