---

id: "mariadb_to_sf_iceberg"
name: "MariaDB managed Iceberg v3 test source"
type: "tap-mysql"
owner: "test-runner"

db_conn:
  host: "${TAP_MYSQL_HOST}"
  port: ${TAP_MYSQL_PORT}
  user: "${TAP_MYSQL_USER}"
  password: "${TAP_MYSQL_PASSWORD}"
  dbname: "${TAP_MYSQL_DB}"
  use_gtid: true
  engine: mariadb

target: "snowflake"
target_table_format: iceberg
iceberg_version: 3
data_flattening_max_level: 0
hard_delete: true
batch_size_rows: 1000
stream_buffer_size: 0

schemas:
  - source_schema: "${TAP_MYSQL_DB}"
    target_schema: "ppw_e2e_tap_mysql${TARGET_SNOWFLAKE_SCHEMA_POSTFIX}"
    tables:
      - table_name: "edgydata"
        replication_method: "LOG_BASED"

      - table_name: "address"
        replication_method: "INCREMENTAL"
        replication_key: "date_updated"

      - table_name: "no_pk_table"
        replication_method: "FULL_TABLE"
