---

id: "postgres_to_sf_native_multiline"
name: "PostgreSQL native multiline FastSync source"
type: "tap-postgres"
owner: "test-runner"

db_conn:
  host: "${TAP_POSTGRES_HOST}"
  logical_poll_total_seconds: 3
  port: ${TAP_POSTGRES_PORT}
  user: "${TAP_POSTGRES_USER}"
  password: "${TAP_POSTGRES_PASSWORD}"
  dbname: "${TAP_POSTGRES_DB}"
  limit: 1000

target: "snowflake"
batch_size_rows: 1000
stream_buffer_size: 0

schemas:
  - source_schema: "public"
    target_schema: "ppw_e2e_tap_postgres_2${TARGET_SNOWFLAKE_SCHEMA_POSTFIX}"
    tables:
      - table_name: "multiline_values"
        replication_method: "INCREMENTAL"
        replication_key: "id"
