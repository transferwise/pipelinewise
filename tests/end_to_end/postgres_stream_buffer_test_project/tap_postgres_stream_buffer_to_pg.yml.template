---

id: "postgres_stream_buffer_recovery"
name: "PostgreSQL stream-buffer recovery source"
type: "tap-postgres"
owner: "test-runner"

db_conn:
  host: "${TAP_POSTGRES_HOST}"
  port: ${TAP_POSTGRES_PORT}
  user: "${TAP_POSTGRES_USER}"
  password: "${TAP_POSTGRES_PASSWORD}"
  dbname: "${TAP_POSTGRES_DB}"
  logical_poll_total_seconds: 45
  break_at_end_lsn: false
  max_run_seconds: 55
  fastsync_parallelism: 1

target: "postgres_stream_buffer_recovery_dwh"
batch_size_rows: 1000
stream_buffer_size: 10

schemas:
  - source_schema: "ppw_e2e_stream_buffer_source"
    target_schema: "ppw_e2e_stream_buffer_target"
    tables:
      - table_name: "buffered_records"
        replication_method: "LOG_BASED"
